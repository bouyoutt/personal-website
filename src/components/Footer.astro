---
import { getProfile } from "../content/profileData";

interface Props {
  lang?: 'zh' | 'en';
}

const { lang = 'zh' } = Astro.props;
const profile = getProfile(lang);
---
<footer class="border-t py-6 md:px-8 md:py-0 w-full max-w-6xl mt-6">
  <div
    class="container flex flex-col items-center justify-between gap-4 md:h-16 md:flex-row"
  >
    <p
      class="text-center text-xs leading-loose text-muted-foreground md:text-left mx-auto"
    >
      © {new Date().getFullYear()} {profile.name}. Built with Astro, React & Tailwind CSS.
    </p>
  </div>
</footer>
