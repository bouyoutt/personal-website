---
interface Props {
  title?: string
  body?: string
}

const { title, body } = Astro.props
---

<div class="flex flex-col h-full w-full justify-between">
  {title && <h2 class="z-20 m-0 text-xl font-bold mb-2">{title}</h2>}
  {body && <p class="m-0 text-base font-light mb-2">{body}</p>}
  <div class="h-full flex flex-col justify-between">
    <slot />
  </div>
</div>
