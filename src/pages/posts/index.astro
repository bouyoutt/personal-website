---
import ProjectCard from 'src/components/ProjectCard.astro'
import { getCollection } from "@/lib/published-content";
import IndexPageLayout from "../../layouts/IndexPageLayout.astro";

// read mdx files from posts folder
const allPosts = await getCollection('posts');

// 优先展示中文文章
const posts = allPosts.filter((p: any) => p.data.lang !== 'en');

// sort posts by startDate DESC
posts.sort((a: any, b: any) => {
  return new Date(b.data.startDate).getTime() - new Date(a.data.startDate).getTime();
});
---

<IndexPageLayout 
  title="博客与思考随笔" 
  description="记录 Java 后端架构实践、现代 Web 探索、Chrome 插件折腾与工程思考。"
  subTitle="技术博客"
  lang="zh"
>
  {
    posts.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {posts.map((entity: any) => (
          <ProjectCard
            key={entity.data.title}
            href={'/posts/' + entity.slug}
            heading={entity.data.title}
            subheading={entity.data.description}
            altText={entity?.data?.image?.alt}
            imagePath={entity?.data?.image?.url}
            dateStart={entity.data.startDate}
          />
        ))}
      </div>
    ) : (
      <div class="rounded-xl border bg-card p-12 text-center text-muted-foreground shadow-sm">
        <p class="text-lg font-medium text-foreground">暂无文章</p>
        <p class="text-sm mt-2 text-muted-foreground">技术博客正在撰写中，欢迎稍后常来看看！</p>
      </div>
    )
  }
</IndexPageLayout>
